{
  "reload_style_on_change": true,
  "toggle": true,
  "layer": "top",
  "position": "left",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "include": ["~/.config/waybar/modules.json"],
  "modules-left": ["custom/arch", "clock", "cpu", "memory", "mpris", "privacy"],
  "modules-center": ["niri/workspaces"],
  "modules-right": [
    "group/extras",
    "pulseaudio#microphone",
    "group/audio"
  ]
}
